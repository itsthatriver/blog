---
import { AUTHOR, CONTENT_LICENSE_URL, GITHUB_URL } from '../consts';

const today = new Date();
---

<footer>
	<p>
		&copy; {today.getFullYear()}
		{AUTHOR}. Writing licensed under <a href={CONTENT_LICENSE_URL} rel="license">CC BY 4.0</a>.
		<a href={`${GITHUB_URL}/blog`}>Source</a> is MIT licensed.
	</p>
</footer>
<style>
	footer {
		padding: 2em 1em 6em 1em;
		background: linear-gradient(var(--gray-gradient)) no-repeat;
		color: rgb(var(--gray));
		text-align: center;
	}
	footer a {
		color: rgb(var(--gray-dark));
	}
</style>
