---
import type { Post } from '../lib/posts';
import FormattedDate from './FormattedDate.astro';
import TagList from './TagList.astro';

interface Props {
	posts: Post[];
}

const { posts } = Astro.props;
---

{posts.length === 0 && <p>No posts yet. Check back soon.</p>}
<ul class="posts">
	{
		posts.map((post) => (
			<li>
				<p class="date">
					<FormattedDate date={post.data.pubDate} />
					{post.data.draft && <span class="draft">draft</span>}
				</p>
				<h3>
					<a href={`/blog/${post.id}/`}>{post.data.title}</a>
				</h3>
				<p class="description">{post.data.description}</p>
				<TagList tags={post.data.tags} />
			</li>
		))
	}
</ul>
<style>
	.posts {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.posts li {
		margin-bottom: 2.5em;
	}
	h3 {
		margin: 0 0 0.25em 0;
		font-size: 1.4em;
	}
	h3 a {
		color: rgb(var(--black));
		text-decoration: none;
	}
	h3 a:hover {
		color: var(--accent);
	}
	.date,
	.description {
		margin: 0 0 0.25em 0;
	}
	.date {
		color: rgb(var(--gray));
		font-size: 0.8em;
	}
	.draft {
		margin-left: 0.5em;
		padding: 0 0.4em;
		border-radius: 4px;
		background: #fde68a;
		color: #78350f;
	}
</style>
