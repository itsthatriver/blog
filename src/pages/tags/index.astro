---
import Page from '../../layouts/Page.astro';
import { getAllTags, getPublishedPosts } from '../../lib/posts';

const posts = await getPublishedPosts();
const tags = getAllTags(posts).map((tag) => ({
	name: tag,
	count: posts.filter((post) => post.data.tags.includes(tag)).length,
}));
---

<Page title="Tags" description="Browse River's Edge posts by topic.">
	<h1>Tags</h1>
	{tags.length === 0 && <p>No tags yet.</p>}
	<ul>
		{
			tags.map(({ name, count }) => (
				<li>
					<a href={`/tags/${name}/`}>#{name}</a> ({count})
				</li>
			))
		}
	</ul>
</Page>
