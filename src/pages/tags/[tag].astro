---
import PostList from '../../components/PostList.astro';
import Page from '../../layouts/Page.astro';
import { getAllTags, getPublishedPosts, type Post } from '../../lib/posts';

export async function getStaticPaths() {
	const posts = await getPublishedPosts();
	return getAllTags(posts).map((tag) => ({
		params: { tag },
		props: { posts: posts.filter((post) => post.data.tags.includes(tag)) },
	}));
}

interface Props {
	posts: Post[];
}

const { tag } = Astro.params;
const { posts } = Astro.props;
---

<Page title={`#${tag}`} description={`River's Edge posts tagged #${tag}.`}>
	<h1>#{tag}</h1>
	<PostList posts={posts} />
	<a href="/tags/">All tags →</a>
</Page>
